{
  "manifest_version": 3,
  "name": "Google Unlocked Premium",
  "version": "3.1",
  "background": {
    "service_worker": "b.js"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://lumendatabase.org/*",
    "*://www.google.com/*",
    "*://www.google.com.eg/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.google.com/search*", "*://www.google.com.eg/search*"],
      "js": ["jquery-3.3.1.min.js", "u.js"]
    }
  ]
}
